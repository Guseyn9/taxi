FSM_ENV=local
DB_HOST=127.0.0.1
DB_PORT=13318
DB_NAME=taxi_fsm
DB_USER=root
DB_PASSWORD=local-fsm-only
FSM_AUTH_MODE=ibronevik
FSM_EXTERNAL_SYNC_ENABLED=1
# Target the same Core tenant as the frontend. Local PHP fixture shown here.
IBRONEVIK_BASE_URL=http://127.0.0.1:18088/taxi/c/local/api/v1
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# All API/FSM/outbox processes use the SAME key. Keep it outside Git and images.
FSM_CREDENTIAL_KEYS=
FSM_REALTIME_BACKEND=redis
FSM_REDIS_URL=redis://127.0.0.1:16318/0
FSM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:18090
# Optional privileged READ-ONLY Core account, never used by the write worker.
FSM_RECONCILE_TOKEN=
FSM_RECONCILE_U_HASH=
FSM_RECONCILE_POLL_SECONDS=15

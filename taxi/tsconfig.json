{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "downlevelIteration": true,
    "strictPropertyInitialization": false,
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "@mona-health/react-input-mask": [
        "./node_modules/@types/react-input-mask"
      ],
      "voice-assistant/platform-runtime": [
        "./node_modules/voice-assistant/packages/platform-runtime/dist/packages/platform-runtime/index.d.ts"
      ],
      "voice-assistant/voice/browser": [
        "./node_modules/voice-assistant/packages/voice/dist/browser/index.d.ts"
      ],
      "voice-assistant/voice/channel": [
        "./node_modules/voice-assistant/packages/voice/dist/channel/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}

{
  "buildCommand": "node tools/build-release.cjs",
  "installCommand": "npm ci --legacy-peer-deps",
  "outputDirectory": "build",
  "framework": null,
  "rewrites": [{"source": "/(.*)", "destination": "/index.html"}],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]},
    {"source": "/static/(.*)", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]},
    {"source": "/mock/(.*)", "headers": [{"key": "Cache-Control", "value": "public,max-age=0,must-revalidate"}]},
    {"source": "/qa/(.*)", "headers": [{"key": "Content-Security-Policy", "value": "connect-src 'none'; form-action 'none'"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/design-v2/vehicles/(.*)", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]}
  ]
}
